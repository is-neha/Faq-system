# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# JWT Secret (change this to a strong random string in production)
JWT_SECRET=change_me_to_a_strong_random_secret

# Server Port
PORT=5000

# Node environment
NODE_ENV=development

# FAQ Promotion Threshold (answer upvotes needed before flagging for admin review)
FAQ_UPVOTE_THRESHOLD=10